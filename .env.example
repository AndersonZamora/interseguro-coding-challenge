# Copiar a .env para desarrollo local con docker-compose.
# Secreto HMAC compartido entre go-api y node-api para firmar/verificar JWT.
JWT_SECRET=change-me-to-a-long-random-string

# Credenciales de demo para POST /auth/token en node-api (no hay modelo de
# usuarios en el reto, se usa un client_id/client_secret fijo).
DEMO_CLIENT_ID=interseguro-demo
DEMO_CLIENT_SECRET=change-me-too

# Origen permitido por CORS en ambas APIs (URL del frontend).
ALLOWED_ORIGIN=http://localhost:8081
